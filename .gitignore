# Build output.
bin/

# Binaries built without -o land in the working directory.
/containerbar
/containerctl
/containerdns
/docscheck
/docsgen

# Go test and coverage output.
*.test
*.out
coverage.*

# The seeded design canvas is generated from the .dc.html sources and the
# canvas manifest, both of which are tracked.
design/containerctl-window.html

# Scratch files written next to a Compose file while an edit is validated.
# They are removed on success; an interrupted run can leave one behind.
*.containerctl-edit
*.containerctl-check

# Certificates and keys are issued per machine by the local authority in
# ~/.containerctl. Nothing of the sort belongs in a repository.
*.crt
*.key
*.pem
*.p12

# macOS and editors.
.DS_Store
.idea/
.vscode/
